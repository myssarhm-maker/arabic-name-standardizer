{
  "manifest_version": 3,
  "name": "Arabic Name Standardizer",
  "version": "0.3.0",
  "description": "Standardize Arabic names and English spelling variants.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arabic Name Standardizer"
  },
  "permissions": [
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
